name: '网易云音乐综合去广告'
desc: '移除网易云音乐可直接拦截的广告请求，尽量避免影响音乐播放'
author: 'zika'
icon: 'https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/icon/qure/color/NeteaseCloudMusic.png'
category: '去广告'

http:
  url-rewrite:
    # 开屏/广告配置
    - ^https?:\/\/.+\/eapi\/ad\/.*$ - reject

    # 广告资源
    - ^https?:\/\/.+\/ad\/.+\.(jpg|jpeg|png|gif|webp|mp4)(\?.*)?$ - reject

    # 明确广告请求
    - ^https?:\/\/admusic\.music\.163\.com\/.*$ - reject
    - ^https?:\/\/iadmusic\.music\.163\.com\/.*$ - reject