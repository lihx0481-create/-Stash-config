name: '百度贴吧综合去广告 · Zika'
desc: 'Zika 自维护的百度贴吧去广告规则，针对开屏、首页 Feed 及广告投放请求进行精确拦截'
author: 'zika'
icon: 'https://raw.githubusercontent.com/lihx0481-create/-Stash-config/main/Stash/icon/Tieba.png'
category: '去广告'

http:
  url-rewrite:

    # 百度广告投放服务
    - ^https?:\/\/afd\.baidu\.com\/.*$ - reject

    # 百度移动广告服务
    - ^https?:\/\/mobads\.baidu\.com\/.*$ - reject

    # 贴吧广告服务器
    - ^https?:\/\/tiebac\.baidu\.com\/.*(?:ad|ads|advert|advertise).* - reject

    # 贴吧开屏广告数据
    - ^https?:\/\/tieba\.baidu\.com\/.*(?:splash|startup|launch).*(?:ad|ads|advert).* - reject

    # 贴吧 Feed 广告请求
    - ^https?:\/\/tiebac\.baidu\.com\/.*(?:feed|homepage).*(?:ad|ads|advert).* - reject

    # 贴吧广告素材
    - ^https?:\/\/[^\/]+\/.*\/(?:ad|ads|advert|advertise)\/.*\.(?:jpg|jpeg|png|webp|gif|mp4)(?:\?.*)?$ - reject