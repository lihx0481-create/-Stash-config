name: '淘宝综合去广告'
desc: '移除淘宝 App 开屏、信息流、弹窗及广告请求'
author: 'zika'
icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taobao.png'
category: '去广告'

http:
  url-rewrite:
    # 1. 开屏 / 启动广告
    - ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query\/.+tao_splash$ - reject-dict

    # 2. 信息流 / 广告配置
    - ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alimama\.etao\.config\.query.*$ - reject-dict
    - ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.etao\.noah\.query.*$ - reject-dict

    # 4. Banner / 页面广告
    - ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get.*$ - reject-dict

    # 5. 弹窗 / 活动广告
    - ^https:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(volvo\.secondfloor\.getconfig|wireless\.home\.newface\.awesome\.get).*?$ - reject-dict

    # 6. 广告配置 / 广告接口
    - ^https:\/\/acs\.m\.taobao\.com\/gw\/mtop\.film\.mtopadvertiseapi\.queryadvertise.*$ - reject-dict