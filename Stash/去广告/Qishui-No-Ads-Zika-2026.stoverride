name: 汽水音乐
desc: |-
    Zika 汽水音乐去广告
    - 视频广告
    - 通用广告
    - 位置请求
    - 广告弹窗
    - TAGS 推荐
    - 我的页面推广
    - 会员免费听整月提示
    - 热门搜索
    - 搜索界面活动
    - 音乐流推广
    - DNS 请求
    - 广告回传
    - 广告素材

category: ad

icon: https://is1-ssl.mzstatic.com/image/thumb/Purple211/v4/7b/3f/0e/7b3f0e7e-0d6c-7e56-4f0c-3a1e5b1c7b4c/AppIcon-0-0-1x_U007emarketing-0-7-0-85-220.png/512x512bb.jpg

http:
    mitm:
        - beta-luna.douyin.com
        - api.qishui.com
        - tnc*-*.zijieapi.com
        - '*.qishui.douyin.com'
        - music-api.douyin.com
        - i.snssdk.com
        - i-lq.snssdk.com
        - mcs.snssdk.com
        - activity-ag.awemeughun.com
        - p6-ad-sign.byteimg.com
        - p9-ad-sign.byteimg.com

    force-http-engine:
        - beta-luna.douyin.com
        - api.qishui.com
        - tnc*-*.zijieapi.com
        - '*.qishui.douyin.com'
        - music-api.douyin.com
        - i.snssdk.com
        - i-lq.snssdk.com
        - mcs.snssdk.com
        - activity-ag.awemeughun.com
        - p6-ad-sign.byteimg.com
        - p9-ad-sign.byteimg.com

    url-rewrite:

        # ==============================
        # Luna 视频广告
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/media_ads(?:\?.*)?$ - reject-200

        # ==============================
        # Luna 通用广告
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/ads(?:\?.*)?$ - reject-200

        # ==============================
        # 位置请求
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/location\/info(?:\?.*)?$ - reject-200

        # ==============================
        # 广告弹窗 / 商业推广
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/commerce(?:\?.*)?$ - reject-200

        # ==============================
        # TAGS 推荐
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/hashtag\/recommend(?:\?.*)?$ - reject-200

        # ==============================
        # DNS 域名配置请求
        # ==============================

        - ^https:\/\/tnc.*zijieapi\.com\/get_domains(?:\?.*)?$ - reject-200

        # ==============================
        # 广告素材
        # ==============================

        - ^https:\/\/p6-ad-sign\.byteimg\.com\/.*$ - reject

        - ^https:\/\/p9-ad-sign\.byteimg\.com\/.*$ - reject

        # ==============================
        # 活动广告回传
        # ==============================

        - ^https:\/\/activity-ag\.awemeughun\.com\/.*$ - reject

        # ==============================
        # 广告回传 / 统计
        # ==============================

        - ^https:\/\/[^\/]+\.qishui\.douyin\.com\/.*\/(?:ad|ads)\/.*(?:report|track|stats|log).*$ - reject

        # ==============================
        # 旧版 / 泛化广告路径
        # ==============================

        - ^https:\/\/[^\/]+\.qishui\.douyin\.com\/.*\/(?:ad|ads|advert|advertisement|commercial)\/.*$ - reject-dict

        # ==============================
        # 播放器推广
        # ==============================

        - ^https:\/\/[^\/]+\.qishui\.douyin\.com\/.*\/(?:player|play)\/.*(?:ad|ads|advert|promotion).*$ - reject-dict

        # ==============================
        # 首页 / 信息流推广
        # ==============================

        - ^https:\/\/[^\/]+\.qishui\.douyin\.com\/.*\/(?:feed|recommend|home)\/.*(?:ad|ads|advert|promotion).*$ - reject-dict

    body-rewrite:

        # ==============================
        # 我的页面推广
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/me\?.*$ response-jq del(.reward_ad_banner)

        # ==============================
        # 会员免费听整月提示
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/card(?:\?.*)?$ response-jq del(.preview_guide)

        # ==============================
        # 热门搜索
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/search-block(?:\?.*)?$ response-jq del(.search_chart_block)

        # ==============================
        # 搜索界面活动
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/activities(?:\?.*)?$ response-jq del(.activity_map)

        # ==============================
        # 音乐流推广
        # ==============================

        - ^https:\/\/[a-zA-Z0-9_-]+(\.[a-zA-Z0-9_-]+){1,3}\/luna\/feed\/song-tab(?:\?.*)?$ response-jq .items |= map(select(.type == "track"))