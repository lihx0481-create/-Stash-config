name: '哔哩哔哩综合去广告'
desc: '移除哔哩哔哩 App 可直接拦截的广告请求'
author: 'zika'
icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/bilibili.png'
category: '去广告'

http:
  url-rewrite:
    # 1. 开屏相关
    - ^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource\?.*$ - reject-dict

    # 2. 信息流 / 推广
    - ^https?:\/\/api\.bilibili\.com\/pgc\/season\/app\/related\/recommend\?.*$ - reject-dict

    # 5. 调研 / 弹窗类
    - ^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\?.*$ - reject-dict

    # 广告服务
    - ^https?:\/\/cm\.bilibili\.com\/.*$ - reject

    # 明确的广告接口
    - ^https?:\/\/api\.bilibili\.com\/x\/v2\/dm\/ad.*$ - reject-dict

    # 漫画广告
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d+\.comic\/flash.*$ - reject-dict

    # 直播电商推广
    - ^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info.*$ - reject-dict