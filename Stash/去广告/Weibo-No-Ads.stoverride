name: '微博综合去广告'
desc: '过滤微博 App 广告及部分推广内容'
author: 'zika'
icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Weibo.png'
category: '去广告'

http:
  url-rewrite:
    # 微博开屏广告
    - ^https?:\/\/(sdk|wb)app\.uve\.weibo\.com\/(interface\/sdk\/sdkad\.php|wbapplua\/wbpullad\.lua).* - reject

    # 微博广告服务
    - ^https?:\/\/biz\.weibo\.com\/.*$ - reject

  script:
    # 微博首页、信息流、搜索等响应处理
    - match: ^https?:\/\/m?api\.weibo\.c(n|om)\/2\/(cardlist|searchall|page|messageflow|statuses\/(unread_)?friends(\/|_)timeline|groups\/timeline|statuses\/(unread_hot_timeline|extend|video_mixtimeline|repost_timeline)|profile\/(me|container_timeline)|video\/(community_tab|remind_info|tiny_stream_video_list)|checkin\/show|!\/live\/media_homelist|comments\/build_comments|container\/get_item|search\/(finder|container_timeline|container_discover)).*
      name: 微博去广告
      type: response
      require-body: true

script-providers:
  微博去广告:
    url: https://raw.githubusercontent.com/zmqcherish/proxy-script/main/weibo_main.js
    interval: 86400