name: '京东去开屏广告'
desc: '移除京东 App 开屏广告'
author: 'zika'
icon: 'https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/JD.png'
category: '去广告'

http:
  mitm:
    - 'hd.mina.mi.com'
  script:
    - match: '^https?:\/\/hd\.mina\.mi\.com\/splashscreen\/alert'
      script-path: 'https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js'
      requires-body: true