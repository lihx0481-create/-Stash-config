name: '京东综合去广告 · Zika'
desc: '移除京东 App 已确认的广告、开屏及营销请求，尽量避免影响正常功能'
author: 'zika'
icon: 'https://raw.githubusercontent.com/NobyDa/mini/master/Color/jd.png'
category: '去广告'

http:
  url-rewrite:
    - ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start(?:&.*)?$ - reject
    - ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=home_launchConfig(?:&.*)?$ - reject
    - ^https?:\/\/lop-proxy\.jd\.com\/queryAppHomePageMarketingRecommendRuleConfigInfo(?:\?.*)?$ - reject
    - ^https?:\/\/(?:bdsp-x|dsp-x)\.jd\.com\/adx\/.*$ - reject

mitm:
  host:
    - api.m.jd.com
    - lop-proxy.jd.com
    - bdsp-x.jd.com
    - dsp-x.jd.com