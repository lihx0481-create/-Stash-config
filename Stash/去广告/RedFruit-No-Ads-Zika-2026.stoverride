name: '红果短剧综合去广告 · Zika 2026'
desc: 'Zika 自维护的红果短剧广告过滤规则｜开屏、插播、全屏、信息流｜2026'
author: 'zika'
icon: 'https://raw.githubusercontent.com/lihx0481-create/-Stash-config/main/Stash/icon/RedFruit.png'
category: '去广告'

http:
  mitm:
    - '*.pangolin-sdk-toutiao.com'
    - '*.pglstatp-toutiao.com'
    - '*.pstatp.com'
    - 'i.snssdk.com'
    - 'i-lq.snssdk.com'
    - 'activity-ag.awemeughun.com'
    - 'dig.bdurl.net'
    - 'p6-ad-sign.byteimg.com'
    - 'p9-ad-sign.byteimg.com'

  url-rewrite:

    # ==========================================
    # ① 开屏广告
    # ==========================================

    - ^https:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/get_ads\/.*$ - reject-dict

    - ^https:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/settings\/.*$ - reject-dict


    # ==========================================
    # ② 剧集间插播 / 全屏广告
    # ==========================================

    - ^https:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/(?:ad|ad-app-package)\/.*$ - reject

    - ^https:\/\/[^\/]+\.pstatp\.com\/obj\/ad-pattern\/.*$ - reject

    - ^https:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/.*(?:ad|ads|advert|advertisement).*\.mp4(?:\?.*)?$ - reject


    # ==========================================
    # ③ 信息流 / Banner 广告
    # ==========================================

    - ^https:\/\/(?:i|i-lq)\.snssdk\.com\/api\/ad\/.*$ - reject-dict

    - ^https:\/\/(?:i|i-lq)\.snssdk\.com\/.*\/(?:ad|ads|advert|advertisement)\/.*$ - reject-dict


    # ==========================================
    # ④ 广告素材
    # ==========================================

    - ^https:\/\/p6-ad-sign\.byteimg\.com\/.*$ - reject

    - ^https:\/\/p9-ad-sign\.byteimg\.com\/.*$ - reject

    - ^https:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/obj\/(?:ad|img\/ad)\/.*$ - reject


    # ==========================================
    # ⑤ 广告曝光 / 点击 / 回传
    # ==========================================

    - ^https:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/stats\/.*$ - reject

    - ^https:\/\/activity-ag\.awemeughun\.com\/.*$ - reject

    - ^https:\/\/dig\.bdurl\.net\/.*$ - reject


    # ==========================================
    # ⑥ 正常视频流保护
    # ==========================================

    # 不封整个 pstatp.com
    # 不封整个 byteimg.com
    # 不封整个 snssdk.com
    # 不封整个 bytedance.com
    #
    # 仅拦截明确广告 API、广告素材和广告回传。