name: '红果短剧综合去广告 · Zika 2026'
desc: 'Zika 自维护的红果短剧广告过滤规则｜开屏、插播、全屏、信息流及广告回传｜2026'
author: 'zika'
icon: 'https://raw.githubusercontent.com/lihx0481-create/-Stash-config/main/Stash/icon/RedFruit.png'
category: '去广告'

http:
  mitm:
    - '*.pangolin-sdk-toutiao.com'
    - '*.pglstatp-toutiao.com'
    - '*.pstatp.com'
    - '*.byteimg.com'
    - 'i.snssdk.com'
    - 'i-lq.snssdk.com'
    - 'is.snssdk.com'
    - 'mcs.snssdk.com'
    - 'security-lq.snssdk.com'
    - 'tnc3-alisc1.snssdk.com'
    - 'tnc3-aliec2.snssdk.com'
    - 'activity-ag.awemeughun.com'
    - 'dig.bdurl.net'
    - '*.zijieapi.com'
    - 'p6-ad-sign.byteimg.com'
    - 'p9-ad-sign.byteimg.com'

  url-rewrite:

    # ==========================================
    # ① 开屏 / 广告获取
    # ==========================================

    - ^https:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/get_ads\/.*$ - reject-dict

    - ^https:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/settings\/.*$ - reject-dict


    # ==========================================
    # ② 剧集间插播 / 全屏视频广告
    # ==========================================

    # 穿山甲广告视频
    - ^https:\/\/[^\/]+\.pglstatp-toutiao\.com\/.+\/toutiao\.mp4(?:\?.*)?$ - reject

    # 广告应用素材
    - ^https:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/(?:obj|img)\/(?:ad-app-package|ad)\/.*$ - reject

    # 广告渲染器
    - ^https:\/\/[^\/]+\.pstatp\.com\/obj\/ad-pattern\/renderer(?:\/.*)?$ - reject

    # 广告图片/素材
    - ^https:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/obj\/(?:ad|img\/ad)\/.*$ - reject

    # 广告素材中明确标记的 MP4
    - ^https:\/\/[^\/]+\.(?:pglstatp-toutiao|pstatp)\.com\/.*\/(?:ad|ads|advert|advertisement)\/.*\.mp4(?:\?.*)?$ - reject


    # ==========================================
    # ③ 信息流 / Banner / 广告 API
    # ==========================================

    - ^https:\/\/(?:i|i-lq)\.snssdk\.com\/api\/ad\/.*$ - reject-dict

    - ^https:\/\/(?:i|i-lq)\.snssdk\.com\/.*\/(?:ad|ads|advert|advertisement)\/.*$ - reject-dict


    # ==========================================
    # ④ 字节广告相关域
    # ==========================================

    - ^https:\/\/mcs\.snssdk\.com\/.*$ - reject

    - ^https:\/\/tnc3-alisc1\.snssdk\.com\/.*$ - reject

    - ^https:\/\/tnc3-aliec2\.snssdk\.com\/.*$ - reject

    - ^https:\/\/security-lq\.snssdk\.com\/.*$ - reject

    - ^https:\/\/is\.snssdk\.com\/.*$ - reject


    # ==========================================
    # ⑤ Zijie 广告链路
    # ==========================================

    - ^https:\/\/[^\/]*zijieapi\.com\/.*$ - reject


    # ==========================================
    # ⑥ 广告签名 / 广告素材
    # ==========================================

    - ^https:\/\/p6-ad-sign\.byteimg\.com\/.*$ - reject

    - ^https:\/\/p9-ad-sign\.byteimg\.com\/.*$ - reject


    # ==========================================
    # ⑦ 广告曝光 / 点击 / 转化
    # ==========================================

    - ^https:\/\/[^\/]+\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/stats\/.*$ - reject

    - ^https:\/\/activity-ag\.awemeughun\.com\/.*$ - reject

    - ^https:\/\/dig\.bdurl\.net\/.*$ - reject


    # ==========================================
    # ⑧ 广告追踪资源
    # ==========================================

    - ^https:\/\/[^\/]+\.pstatp\.com\/bytecom\/resource\/track_log\/src\/.*$ - reject

    - ^https:\/\/[^\/]+\.pstatp\.com\/obj\/mosaic-legacy\/.*\?from=ad.*$ - reject


    # ==========================================
    # ⑨ 正常视频流保护
    # ==========================================

    # 不封整个：
    # pstatp.com
    # byteimg.com
    # snssdk.com
    # bytedance.com
    #
    # 正常剧集视频、普通图片 CDN、正常业务 API
    # 不进行整域拦截。