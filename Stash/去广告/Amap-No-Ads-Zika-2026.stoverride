name: '高德地图综合去广告 · Zika 2026'
desc: 'Zika 自维护的高德地图推广内容过滤规则｜2026'
author: 'zika'
icon: 'https://raw.githubusercontent.com/lihx0481-create/-Stash-config/main/Stash/icon/Amap.png'
category: '去广告'

http:
  mitm:
    - m5.amap.com
    - m5-zb.amap.com
    - amap-aos-info-nogw.amap.com
    - free-aos-cdn-image.amap.com

  url-rewrite:

    # ==========================================
    # ① 当前已取消开屏广告
    # ==========================================
    # 2026-06 实测高德地图已无开屏广告
    # 不添加旧版 splash_screen 拦截，避免误杀正常启动请求。


    # ==========================================
    # ② 首页/搜索推广
    # ==========================================

    # 搜索热词推广
    - ^https:\/\/m5\.amap\.com\/ws\/shield\/search\/new_hotword(?:\?.*)?$ - reject-dict

    # POI 搜索广告提示
    - ^https:\/\/m5\.amap\.com\/ws\/shield\/search_poi\/tips_adv(?:\?.*)?$ - reject-dict


    # ==========================================
    # ③ 地点详情推广
    # ==========================================

    - ^https:\/\/m5\.amap\.com\/ws\/shield\/search\/common\/coupon\/info(?:\?.*)?$ - reject-dict

    # 商家营销推广
    - ^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured(?:\?.*)?$ - reject-dict


    # ==========================================
    # ④ 导航结束页推广
    # ==========================================

    - ^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/card-service-car-end(?:\?.*)?$ - reject-dict

    # 路线规划页推广卡片
    - ^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan(?:\?.*)?$ - reject-dict


    # ==========================================
    # ⑤ 明确广告/推广资源域
    # ==========================================

    - ^https:\/\/amap-aos-info-nogw\.amap\.com\/.*$ - reject

    - ^https:\/\/free-aos-cdn-image\.amap\.com\/.*$ - reject