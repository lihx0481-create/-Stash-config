name: '抖音综合去广告 · Zika'
desc: 'Zika 自维护的抖音去广告规则'
author: 'zika'
category: '去广告'

http:
  url-rewrite:
    - ^https?:\/\/webcast-open\.douyin\.com\/webcast\/openapi\/feed\/\?.*$ - reject

    # 穿山甲广告 SDK（字节跳动系通用）
    - ^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/get_ads(?:\?.*)?$ - reject
    - ^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/server_bidding\/pre_fetch\/.*$ - reject
    - ^https?:\/\/sf3-fe-tos\.pglstatp-toutiao\.com\/obj\/ad-pattern\/renderer\/.*$ - reject

mitm:
  host:
    - webcast-open.douyin.com
    - api-access.pangolin-sdk-toutiao.com