name: 微信小程序 · 朋友圈去广告 · Zika 2026
desc: ‘Zika 自维护｜微信朋友圈与小程序广告过滤｜2026’
author: ‘zika’
icon: ‘https://appicons.co/icons/100445’
category: ‘去广告’
version: ‘1.0.0’
date: ‘2026-08-18’

http:
mitm:
- ‘.weixin.qq.com’
- ’.wx.qq.com’
- ‘.wechat.com’
- ’.wxapp.tc.qq.com’

url-rewrite:

# ==========================================
# 微信朋友圈 / 小程序
# 明确广告接口
# ==========================================
- ^https?:\/\/[^\/]+\/.*\/(?:ad|ads|advert|advertisement|adinfo|adconfig|adunit)(?:\/|\?|$).* - reject-dict
# ==========================================
# 广告曝光 / 点击 / 统计
# ==========================================
- ^https?:\/\/[^\/]+\/.*\/(?:ad|ads)\/.*(?:report|track|click|exposure|impression|statistics|stats|callback)(?:\/|\?|$).* - reject-dict
# ==========================================
# 广告素材
# ==========================================
- ^https?:\/\/[^\/]+\/.*\/(?:ad|ads|advert|advertisement)\/.*\.(?:jpg|jpeg|png|webp|gif|mp4|m3u8)(?:\?.*)?$ - reject
# ==========================================
# 广告配置 / 广告单元
# ==========================================
- ^https?:\/\/[^\/]+\/.*(?:adinfo|adconfig|adunit|advertconfig|advertising)(?:\/|\?|$).* - reject-dict
# ==========================================
# 广告推广 / 落地页
# ==========================================
- ^https?:\/\/[^\/]+\/.*\/(?:ad|ads)\/.*(?:landing|promotion|promote|native)(?:\/|\?|$).* - reject-dict
# ==========================================
# 明确广告参数
# ==========================================
- ^https?:\/\/[^\/]+\/.*[?&](?:adid|ad_id|adunit|ad_unit|advertid|advert_id|promotionid|promotion_id)=.* - reject-dict
# ==========================================
# 广告素材 CDN
# ==========================================
- ^https?:\/\/[^\/]+\/.*\/(?:ad|ads|advert|advertisement)\/.* - reject
# ==========================================
# 安全原则
# ==========================================
# 不整域 REJECT 微信。
# 不拦截：
# - 微信聊天
# - 正常朋友圈
# - 公众号
# - 微信支付
# - 登录 / 验证
# - 小程序正常 API
# - 小程序正常图片 / 视频
#
# 只有 URL 明确表现为广告请求时才进行处理。