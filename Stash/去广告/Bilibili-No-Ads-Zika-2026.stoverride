name: '哔哩哔哩去广告 · Zika 2026'
desc: 'Zika 自维护｜Bilibili 开屏广告与广告资源过滤｜2026'
author: 'zika'
icon: 'https://appicons.co/icons/147654'
category: '去广告'
version: '1.0.5'
date: '2026-08-19'

http:
  rewrite:

    # =====================================
    # Bilibili 官方开屏接口
    # =====================================

    # 开屏广告展示
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show(?:\?.*)?$ - reject-dict

    # 开屏广告列表
    - ^https?:\/\/app\.bilibili\.com\/x\/v\d+\/splash\/list(?:\?.*)?$ - reject-dict

    # 开屏品牌广告
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list(?:\?.*)?$ - reject-dict

    # 开屏活动广告
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/event\/list2(?:\?.*)?$ - reject-dict

    # =====================================
    # Bilibili 广告资源接口
    # =====================================

    - ^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource(?:\?.*)?$ - reject-dict

    - ^https?:\/\/app\.bilibili\.com\/x\/resource\/peak\/download(?:\?.*)?$ - reject-dict

    # =====================================
    # Bilibili SPLASH 广告资源
    # =====================================

    - ^http:\/\/[\d.]+:8000\/v1\/resource\/[A-Za-z0-9_-]+-1-SPLASH(?:\?.*)?$ - reject-dict

    - ^https?:\/\/upos-[^\/]+\.bilivideo\.com\/.*\/[A-Za-z0-9_-]+-1-SPLASH(?:\?.*)?$ - reject

    - ^https?:\/\/upos-sz-static\.bilivideo\.com\/.*-1-SPLASH(?:\?.*)?$ - reject

    # =====================================
    # Bilibili 专用第三方 DSP 广告接口
    # =====================================

    - ^https?:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_bilibili(?:\?.*)?$ - reject-200

mitm:
  - app.bilibili.com
  - api.bilibili.com
  - '*.bilibili.com'
  - '*.bilivideo.com'
  - '*.bilivideo.cn'
  - t-dsp.pinduoduo.com