name: '哔哩哔哩去广告 · Zika 2026'
desc: 'Zika 自维护｜Bilibili 开屏广告与广告资源过滤｜2026'
author: 'zika'
icon: 'https://appicons.co/icons/147654'
category: '去广告'
version: '2.0.0'
date: '2026-08-19'

http:
  rewrite:

    # =====================================
    # Bilibili 开屏广告
    # =====================================

    # 开屏展示接口
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show(?:\?.*)?$ - reject

    # 开屏广告资源接口
    - ^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource(?:\?.*)?$ - reject-dict

    # 开屏资源下载
    - ^https?:\/\/app\.bilibili\.com\/x\/resource\/peak\/download(?:\?.*)?$ - reject-dict

    # 本地 SPLASH 资源
    - ^http:\/\/[\d.]+:8000\/v1\/resource\/[A-Za-z0-9_-]+-1-SPLASH(?:\?.*)?$ - reject-dict

    # Bilibili 视频 CDN SPLASH 资源
    - ^https?:\/\/upos-[^\/]+\.bilivideo\.com\/.*\/[A-Za-z0-9_-]+-1-SPLASH(?:\?.*)?$ - reject

    # 静态 SPLASH 资源
    - ^https?:\/\/upos-sz-static\.bilivideo\.com\/.*-1-SPLASH(?:\?.*)?$ - reject

    # =====================================
    # Bilibili 专用 DSP 广告
    # =====================================

    # 你实际抓到的：
    # t-dsp.pinduoduo.com/dspcb/i/mrk_bilibili
    - ^https?:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_bilibili(?:\?.*)?$ - reject-200

  body-rewrite:

    # =====================================
    # 核心：清空 Bilibili 开屏返回数据
    # =====================================

    # Bilibili HD / App 开屏
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/list(?:\?.*)?$ response-jq .data={}

    # 部分版本开屏活动数据
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/event\/list2(?:\?.*)?$ response-jq .data={}

    # 部分版本品牌开屏数据
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/brand\/list(?:\?.*)?$ response-jq .data={}

mitm:
  - app.bilibili.com
  - api.bilibili.com
  - '*.bilivideo.com'
  - '*.bilivideo.cn'
  - t-dsp.pinduoduo.com