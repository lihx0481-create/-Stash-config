name: '哔哩哔哩综合去广告 · Zika 2026'
desc: 'Zika 自维护的哔哩哔哩广告过滤规则｜开屏、播放页、卡片、搜索推广及广告回传｜2026'
author: 'zika'
icon: 'https://raw.githubusercontent.com/lihx0481-create/-Stash-config/main/Stash/icon/Bilibili.png'
category: '去广告'

http:
  mitm:
    - app.bilibili.com
    - api.bilibili.com
    - biliapi.net
    - api.biliapi.net

  url-rewrite:

    # ==========================================
    # ① 开屏广告
    # ==========================================

    # 开屏广告展示
    - ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/show(?:\?.*)?$ - reject-dict

    # 开屏广告预加载
    - ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list(?:\?.*)?$ - reject-dict

    # 开屏活动/品牌广告
    - ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(?:brand\/list|event\/list2)(?:\?.*)?$ - reject-dict


    # ==========================================
    # ② 播放页广告
    # ==========================================

    # 播放页弹窗/广告
    - ^https:\/\/api\.bilibili\.com\/x\/v2\/dm\/ad(?:\?.*)?$ - reject-dict

    # VIP 广告素材回传
    - ^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report(?:\?.*)?$ - reject-dict


    # ==========================================
    # ③ 视频卡片广告
    # ==========================================

    - ^https:\/\/api\.bilibili\.com\/pgc\/season\/player\/cards(?:\?.*)?$ - reject-dict


    # ==========================================
    # ④ 搜索推广
    # ==========================================

    # 搜索默认推广词
    - ^https:\/\/app\.bilibili\.com\/x\/v2\/search\/defaultwords(?:\?.*)?$ - reject-dict

    # 新版搜索默认词接口
    - ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords(?:\?.*)?$ - reject-dict


    # ==========================================
    # ⑤ 顶部活动 / 推广
    # ==========================================

    - ^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity(?:\?.*)?$ - reject-dict


    # ==========================================
    # ⑥ 广告追踪 / 商业化回传
    # ==========================================

    - ^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/.*$ - reject-dict

    - ^https:\/\/api\.bilibili\.com\/x\/v2\/.*\/ad(?:\/.*)?(?:\?.*)?$ - reject-dict


    # ==========================================
    # ⑦ 正常视频流保护
    # ==========================================

    # 不拦：
    # app.bilibili.com/x/v2/feed/index
    # app.bilibili.com/x/v2/view
    # api.bilibili.com/x/player/*
    # grpc.biliapi.net 正常播放接口
    # bilivideo.com / hdslb.com 视频 CDN
    #
    # 不整域封 Bilibili API。