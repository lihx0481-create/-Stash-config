name: '哔哩哔哩开屏去广告 · Zika 2026'
desc: 'Zika 自维护｜Bilibili 开屏广告响应过滤'
author: 'zika'
icon: 'https://appicons.co/icons/147654'
category: '去广告'
version: '1.0.1'
date: '2026-08-19'

http:
  url-rewrite:
    - ^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/show(?:\?.*)?$ - reject-dict
    - ^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource(?:\?.*)?$ - reject-dict
    - ^http:\/\/[\d.]+:8000\/v1\/resource\/[A-Za-z0-9_-]+-1-SPLASH(?:\?.*)?$ - reject
    - ^https?:\/\/upos-[^\/]+\.bilivideo\.com\/.*\/[A-Za-z0-9_-]+-1-SPLASH(?:\?.*)?$ - reject

mitm:
  host:
    - app.bilibili.com
    - api.bilibili.com
    - '*.bilivideo.com'
    - '*.bilivideo.cn'