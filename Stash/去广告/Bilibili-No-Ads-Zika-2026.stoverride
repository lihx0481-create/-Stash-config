name: 哔哩哔哩
desc: |-
    Zika Bilibili 去广告
    - 开屏广告
    - 首页推荐广告
    - 首页 Banner
    - 新内容提示
    - 后台切前台闪屏
    - 直播间 Banner
    - 直播商品推荐
    - 商品悬浮窗
    - 购物车
    - 活动卡片
    - 人气榜引导
    - 直播间推广组件
    - 特定推广图片
    - 直播网页广告及干扰内容

category: ad

icon: https://appicons.co/icons/147654

http:
    mitm:
        - app.bilibili.com
        - api.live.bilibili.com
        - i1.hdslb.com
        - i2.hdslb.com
        - www.bilibili.com
        - m.bilibili.com
        - bilibili.com
        - live.bilibili.com

    force-http-engine:
        - api.live.bilibili.com
        - app.bilibili.com
        - bilibili.com
        - i1.hdslb.com
        - i2.hdslb.com
        - live.bilibili.com
        - m.bilibili.com
        - www.bilibili.com

    url-rewrite:
        # 开屏广告
        - https?://app.bilibili.com/x/v2/splash/show - reject

        # 直播间活动/互动推广
        - https://api.live.bilibili.com/xlive/app-ucenter/v2/playTogether/GetPlayTogetherUserAnchorInfoV2 - reject
        - https://api.live.bilibili.com/xlive/app-ucenter/v2/playTogether/PlayTogetherServiceCardDetail - reject

        # 特定推广图片
        - https://i1.hdslb.com/bfs/activity-plat/static/9bdd988aed64a23976d6d5494533a450/vBISHozSu0.png - reject
        - https://i2.hdslb.com/bfs/activity-plat/static/9bdd988aed64a23976d6d5494533a450/vBISHozSu0.png - reject

    body-rewrite:
        # 首页推荐：过滤 Banner
        - ^https?://app.bilibili.com/x/v2/feed/index.*$ response-jq if .data.items!=null then .data.items |= map(select(.card_type!="banner_ipad_v8")) end

        # 首页推荐：过滤广告卡片
        - ^https?://app.bilibili.com/x/v2/feed/index.*$ response-jq if .data.items!=null then .data.items |= map(select(.card_goto!="ad_web_s")) end

        # 开屏数据
        - https?://app.bilibili.com/x/v2/splash/list response-jq .data={}

        # 直播 Banner
        - https://api.live.bilibili.com/xlive/play-interface/widgetService/GetWidgetBannerList response-jq .data={}

        # 直播商品推荐
        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info response-jq .data.recommend_card_detail={}

        # 商品跳转弹窗
        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info response-jq .data.h5jump_popup=[]

        # 当前推荐商品
        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info response-jq .data.selected_goods={}

        # 商品气泡
        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info response-jq .data.bubbles_detail={}

        # 商品卡片
        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info response-jq .data.shopping_card_detail={}

        # 直播购物车
        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_cart_list response-jq .data.goods_list=[]

        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_cart_list response-jq .data.has_next_page=false

        - https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_cart_list response-jq .data.introduce_goods=null

        # 直播间活动 Banner
        - https://api.live.bilibili.com/xlive/app-room/v1/index/getInfoByRoom response-jq .data.activity_banner_info={}

        # 直播间功能卡片
        - https://api.live.bilibili.com/xlive/app-room/v1/index/getInfoByRoom response-jq .data.function_card=null

        # 多视角推荐
        - https://api.live.bilibili.com/xlive/app-room/v1/index/getInfoByRoom response-jq .data.multi_view_info={}

        # 人气榜引导
        - https://api.live.bilibili.com/xlive/app-room/v1/index/getInfoByUser response-jq .data.popular_rank_guide_card={}

        # 首页 Toast / 新内容提示
        - https://app.bilibili.com/x/v2/feed/index response-jq .data.config.toast=null

    script:
        - name: bilibili
          binary-mode: false
          match: https://live.bilibili.com/\d+
          max-size: 2097152
          require-body: true
          timeout: 10
          argument: ''
          type: response
          debug: false

script-providers:
    bilibili:
        url: https://raw.githubusercontent.com/qsoyq/stash/main/script/ad/bilibili.js
        interval: 86400